    "eslint": "^8.46.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.2",
    "vitest": "^1.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
